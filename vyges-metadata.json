{
  "$schema": "https://vyges.com/schema/v1/vyges-metadata.schema.json",
  "x-version": "1.0.0",
  "name": "cf-uart",
  "version": "0.1.0",
  "description": "Configurable UART controller from ChipFoundry. Features: 5-9 data bits, even/odd/stick/no parity, 1-2 stop bits, line-break detection, configurable RX timeout, RX glitch filter, data-match detection, 16-byte TX/RX FIFOs with programmable thresholds, 16-bit baud prescaler, 10 IRQ sources, loopback for test. APB / AHB-Lite / Wishbone wrappers provided.",
  "license": "Apache-2.0",
  "maturity": "stable",
  "target": [
    "asic",
    "fpga"
  ],
  "design_type": [
    "digital",
    "peripheral",
    "communication"
  ],
  "created": "2026-05-20T21:38:52Z",
  "updated": "2026-06-25T03:34:07Z",
  "source": {
    "type": "git",
    "url": "https://github.com/chipfoundry/CF_UART",
    "commit": "00c0da0ccd857e695a485b85e0c8619ea8ec359d",
    "private": false,
    "containsEncryptedPayload": false,
    "indexing": true
  },
  "maintainers": [
    {
      "name": "Vyges",
      "url": "https://vyges.com",
      "github": "vyges"
    }
  ],
  "interfaces": [
    {
      "name": "clock",
      "type": "clock",
      "direction": "input",
      "signals": [
        {
          "name": "clk_i",
          "direction": "input",
          "type": "clock",
          "width": 1
        }
      ]
    },
    {
      "name": "reset",
      "type": "reset",
      "direction": "input",
      "signals": [
        {
          "name": "rst_ni",
          "direction": "input",
          "type": "reset",
          "width": 1,
          "active_level": "low"
        }
      ]
    },
    {
      "name": "apb",
      "type": "bus",
      "protocol": "apb",
      "direction": "slave",
      "description": "APB4 slave (via the vyges_cf_uart_apb overlay).",
      "signals": [
        {
          "name": "PADDR",
          "direction": "input",
          "type": "address",
          "width": 32
        },
        {
          "name": "PWRITE",
          "direction": "input",
          "type": "control",
          "width": 1
        },
        {
          "name": "PWDATA",
          "direction": "input",
          "type": "data",
          "width": 32
        },
        {
          "name": "PSEL",
          "direction": "input",
          "type": "control",
          "width": 1
        },
        {
          "name": "PENABLE",
          "direction": "input",
          "type": "control",
          "width": 1
        },
        {
          "name": "PREADY",
          "direction": "output",
          "type": "control",
          "width": 1
        },
        {
          "name": "PRDATA",
          "direction": "output",
          "type": "data",
          "width": 32
        }
      ]
    },
    {
      "name": "uart_rx",
      "type": "io",
      "direction": "input",
      "signals": [
        {
          "name": "rx",
          "direction": "input",
          "type": "data",
          "width": 1
        }
      ]
    },
    {
      "name": "uart_tx",
      "type": "io",
      "direction": "output",
      "signals": [
        {
          "name": "tx",
          "direction": "output",
          "type": "data",
          "width": 1
        }
      ]
    },
    {
      "name": "irq",
      "type": "interrupt",
      "direction": "output",
      "signals": [
        {
          "name": "IRQ",
          "direction": "output",
          "type": "interrupt",
          "width": 1
        }
      ]
    }
  ],
  "parameters": [
    {
      "name": "MDW",
      "type": "int",
      "default": 9,
      "description": "Maximum UART data size/width (data path width)."
    },
    {
      "name": "SC",
      "type": "int",
      "default": 8,
      "description": "Number of RX oversampling samples per bit (UART_RX/UART_TX NUM_SAMPLES)."
    }
  ],
  "tags": [
    "uart",
    "serial",
    "peripheral",
    "chipfoundry",
    "sky130"
  ],
  "integration": {
    "soc_generator_hints": {
      "top_module": "vyges_cf_uart_apb",
      "clock": {
        "port": "PCLK"
      },
      "reset": {
        "port": "PRESETn"
      },
      "bus_slave": {
        "addr_width": 32,
        "ports": {
          "psel": "PSEL",
          "penable": "PENABLE",
          "pwrite": "PWRITE",
          "paddr": "PADDR",
          "pwdata": "PWDATA",
          "prdata": "PRDATA",
          "pready": "PREADY"
        }
      },
      "note": "Vyges overlay vyges_cf_uart_apb (vyges-additions/) presents clk_i/rst_ni + a clean APB4 slave + rx/tx/IRQ; wraps CF_UART_APB (clk_i->PCLK, rst_ni->PRESETn). Generic generator wires it with no IP-specific handling."
    }
  },
  "dependencies": [
    {
      "name": "cf-ip-util",
      "scope": [
        "rtl"
      ]
    }
  ],
  "registers": [
    {
      "name": "RXDATA",
      "offset": "0x00",
      "access": "RO",
      "description": "RX data (pop one byte from RX FIFO)"
    },
    {
      "name": "TXDATA",
      "offset": "0x04",
      "access": "WO",
      "description": "TX data (push one byte to TX FIFO)"
    },
    {
      "name": "PR",
      "offset": "0x08",
      "access": "RW",
      "description": "Baud prescaler: divisor = clk/baud (integer)"
    },
    {
      "name": "CTRL",
      "offset": "0x0C",
      "access": "RW",
      "description": "Control: en[0], tx_en[1], rx_en[2], loopback[3], glitch_filter[4]"
    },
    {
      "name": "CFG",
      "offset": "0x10",
      "access": "RW",
      "description": "Config: data bits[3:0], parity[5:4], stop bits[8]"
    },
    {
      "name": "MATCH",
      "offset": "0x1C",
      "access": "RW",
      "description": "RX match value (match-interrupt compare byte)"
    },
    {
      "name": "RX_FIFO_LEVEL",
      "offset": "0xFE00",
      "access": "RO",
      "description": "RX FIFO occupancy (>0 => byte available)"
    },
    {
      "name": "RX_FIFO_THRESHOLD",
      "offset": "0xFE04",
      "access": "RW",
      "description": "RX FIFO interrupt threshold"
    },
    {
      "name": "RX_FIFO_FLUSH",
      "offset": "0xFE08",
      "access": "WO",
      "description": "Write 1 to flush RX FIFO"
    },
    {
      "name": "TX_FIFO_LEVEL",
      "offset": "0xFE10",
      "access": "RO",
      "description": "TX FIFO occupancy (< depth => space to write)"
    },
    {
      "name": "TX_FIFO_THRESHOLD",
      "offset": "0xFE14",
      "access": "RW",
      "description": "TX FIFO interrupt threshold"
    },
    {
      "name": "TX_FIFO_FLUSH",
      "offset": "0xFE18",
      "access": "WO",
      "description": "Write 1 to flush TX FIFO"
    },
    {
      "name": "IM",
      "offset": "0xFF00",
      "access": "RW",
      "description": "Interrupt mask"
    },
    {
      "name": "MIS",
      "offset": "0xFF04",
      "access": "RO",
      "description": "Masked interrupt status"
    },
    {
      "name": "RIS",
      "offset": "0xFF08",
      "access": "RO",
      "description": "Raw interrupt status"
    },
    {
      "name": "IC",
      "offset": "0xFF0C",
      "access": "WO",
      "description": "Interrupt clear (W1C)"
    }
  ]
}
